# Optional privacy-safe aggregate telemetry endpoint. Leave empty to disable all telemetry.
# The provider must not set cookies, must discard or truncate IP addresses, and must publish
# a short retention/deletion period. Use an HTTPS endpoint or a same-origin path.
VITE_TELEMETRY_ENDPOINT=/api/telemetry

# Set this once a custom HTTPS domain is connected. Build output, canonical URLs,
# social metadata, structured data, robots, and sitemap all derive from it.
VITE_SITE_URL=https://mission-portfolio-amber.vercel.app

# Server-only optional Upstash-compatible Redis REST store for daily aggregate counts.
TELEMETRY_REDIS_REST_URL=
TELEMETRY_REDIS_REST_TOKEN=
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_DASHBOARD_TOKEN=
